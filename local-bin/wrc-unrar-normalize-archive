#!/usr/bin/env python3
import argparse
import re
import subprocess
import sys
from pathlib import Path

def unrar(archive: Path, destination: Path, password: str | None = None):
    cmd = ["unrar", "e", "-o-"]

    if password != None:
        cmd.append(f"-p{password}")

    cmd += [str(archive), str(destination)]

    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error: Failed to extract '{archive.name}'")
        print(e.stderr)
        sys.exit(e.returncode)

    print("Extraction completed successfully")

def mmv(from_pattern: str, to_pattern: str):
    print(f"running mmv {from_pattern} {to_pattern}")
    subprocess.run(["mmv", from_pattern, to_pattern])

def get_basename(archive_stem: str):
    basename = archive_stem.lower()
    basename = basename.replace(" ", "-")
    return re.sub(r"-+", '-', basename)

def main():
    parser = argparse.ArgumentParser(description="Extract and normalize contents of a rar archive")
    parser.add_argument("archive", type=Path)
    parser.add_argument("directory_name", type=str, nargs="?", default=None)
    parser.add_argument("--password", "-p", type=str, default=None)
    args = parser.parse_args()

    archive = args.archive
    directory_name = args.directory_name or get_basename(archive.stem)
    password = args.password

    output_directory = Path(f"./{directory_name}/")

    try:
        output_directory.mkdir()
    except FileExistsError:
        print(f"Error: Directory '{directory_name}' already exists")
        sys.exit(1)

    unrar(archive, output_directory, password)
    mmv(f"{directory_name}/*(*)*", f"{directory_name}/{directory_name}-#2#3")
    mmv(f"{directory_name}/*.GIF", f"{directory_name}/#1.gif")
    mmv(f"{directory_name}/*.JPG", f"{directory_name}/#1.jpg")
    mmv(f"{directory_name}/*.PNG", f"{directory_name}/#1.png")
    mmv(f"{directory_name}/*.MOV", f"{directory_name}/#1.mov")
    mmv(f"{directory_name}/*.jpeg", f"{directory_name}/#1.jpg")

if __name__ == "__main__":
    main()

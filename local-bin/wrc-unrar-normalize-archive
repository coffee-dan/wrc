#!/usr/bin/env python3
import argparse
import re
import string
import subprocess
import sys
from pathlib import Path

def unrar(archive: Path, destination: Path, password: str | None = None):
    cmd = ["unrar", "e", "-cl", "-o-"]

    if password != None:
        cmd.append(f"-p{password}")

    cmd += [str(archive), str(destination)]

    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error: Failed to extract '{archive.name}'")
        print(e.stderr)
        sys.exit(e.returncode)

    print("Extraction completed successfully")

def extract7z(archive: Path, destination: Path, password: str | None = None):
    cmd = ["7z", "e", "-aos"]

    if password != None:
        cmd.append(f"-p{password}")

    cmd += [str(archive), str(destination)]

    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error: Failed to extract '{archive.name}'")
        print(e.stderr)
        sys.exit(e.returncode)

def mmv(from_pattern: str, to_pattern: str):
    print(f"running mmv {from_pattern} {to_pattern}")
    subprocess.run(["mmv", from_pattern, to_pattern])

def get_basename(archive_stem: str):
    basename = archive_stem
    basename = basename.replace(" ", "-")
    return re.sub(r"-+", '-', basename)

ext_priority = {
    ".png":  0,
    ".jpg":  1,
    ".jpeg": 1,
    ".gif":  2,
    ".mov":  3,
    ".mp4":  4
}

def sort_by_ext_then_name(file: Path):
    ext_order = ext_priority.get(file.suffix, float('inf'))
    old_name = re.sub(r"[()]", "", file.stem.strip())
    text = old_name.rstrip(string.digits)
    trailing_num = re.search(r"(\d+)$", old_name).group(0)
    if not trailing_num:
        trailing_num = float('inf')
    else:
        trailing_num = int(trailing_num)

    return (ext_order, text, trailing_num)

def renumerate(directory: Path):
    files = []
    directory_name = directory.name

    for f in directory.iterdir():
        if f.is_file():
            files.append(f)

    files.sort(
        key=sort_by_ext_then_name
    )

    index = 1
    for f in files:
        new_name = f'{directory_name}-{index}{f.suffix}'
        new_destination = directory.joinpath(new_name)

        if f.name != new_name:
            print(f"renaming {f.name} -> {new_name}")
            f.rename(new_destination)

        index += 1

def create_directory(directory: Path):
    try:
        directory.mkdir()
    except FileExistsError:
        print(f"Directory '{directory.name}' already exists")

def main():
    parser = argparse.ArgumentParser(description="Extract and normalize contents of a rar archive")
    parser.add_argument("--action", "-a", type=str, choices=["all", "extract", "normalize"], default="all")
    parser.add_argument("--target", "-t", type=str, default=None)
    parser.add_argument("--password", "-p", type=str, default=None)
    parser.add_argument("archive", type=Path)
    args = parser.parse_args()

    archive = args.archive
    target = args.target or get_basename(archive.stem)
    target_directory = Path.cwd().joinpath(target)

    extracting = False
    normalizing = False
    match args.action:
        case "all":
            extracting = True
            normalizing = True
        case "extract":
            extracting = True
        case "normalize":
            normalizing = True

    create_directory(target_directory)

    if extracting:
        unrar(archive, target_directory, args.password)

    if normalizing:
        renumerate(target_directory)

if __name__ == "__main__":
    main()
